{
  "name": "uair-framework",
  "version": "0.68.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "node scripts/build-workspace.mjs",
    "typecheck": "node scripts/build-workspace.mjs",
    "clean": "find packages examples -name dist -type d -prune -exec rm -rf {} + && find packages examples -name '*.tsbuildinfo' -type f -delete",
    "verify": "node scripts/verify.mjs",
    "chaos": "node examples/chaos-harness/dist/index.js",
    "check:api": "node scripts/check-v1-api.mjs",
    "test:postgres": "node examples/postgres-integration/index.mjs",
    "test:postgres-multiprocess": "node scripts/check-postgres-multiprocess.mjs",
    "check:postgres-gate": "node scripts/check-postgres-gate.mjs",
    "test:process-crash": "node examples/process-crash-harness/dist/index.js",
    "check:dx": "node scripts/check-developer-experience.mjs",
    "check:agent-validation": "node scripts/check-agent-validation.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "soak": "node scripts/soak.mjs",
    "check:surface": "node scripts/check-ui-surface.mjs",
    "check:agent-boundary": "node scripts/check-agent-boundary.mjs",
    "check:agent-compatibility": "node scripts/check-agent-compatibility-matrix.mjs",
    "check:suspension-race": "node scripts/check-suspension-race.mjs",
    "check:storage-schema": "node scripts/check-storage-schema.mjs",
    "check:sqlite-adversarial": "node scripts/check-sqlite-adversarial.mjs",
    "check:sqlite-crash-points": "node scripts/check-sqlite-crash-points.mjs",
    "check:queue-faults": "node scripts/check-queue-fault-matrix.mjs",
    "check:security-hardening": "node scripts/check-security-hardening.mjs",
    "check:adapter-api": "node scripts/check-adapter-api.mjs",
    "check:upgrade-compatibility": "node scripts/check-upgrade-compatibility.mjs",
    "check:package-lifecycle": "node scripts/check-package-lifecycle.mjs",
    "check:operability": "node scripts/check-operability.mjs",
    "check:identity-dx": "node scripts/check-identity-dx.mjs",
    "check:create-uair": "node scripts/check-create-uair.mjs",
    "check:docs-acceptance": "node scripts/check-docs-acceptance.mjs",
    "test:soak-smoke": "node scripts/run-soak.mjs --cycles 3",
    "test:soak": "node scripts/run-soak.mjs --cycles 100",
    "release:live-gate": "node scripts/run-live-release-gate.mjs",
    "release:check": "node scripts/run-release-check.mjs",
    "release:full": "npm run release:check && npm run release:live-gate",
    "check:api-dx-audit": "node scripts/check-api-dx-audit.mjs",
    "release:metadata": "node scripts/stamp-release-metadata.mjs",
    "release:plan": "node scripts/release-plan.mjs",
    "check:release-candidate-source": "node scripts/check-release-candidate-source.mjs",
    "check:package-boundaries": "node scripts/check-package-boundaries.mjs",
    "check:durable-semantics": "node scripts/check-durable-semantics.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/guyuedumingx/uair-framework.git"
  },
  "homepage": "https://github.com/guyuedumingx/uair-framework#readme",
  "bugs": {
    "url": "https://github.com/guyuedumingx/uair-framework/issues"
  }
}
